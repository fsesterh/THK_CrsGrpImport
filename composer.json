{
  "name": "databay/crsgrp-import",
  "description": "An ILIAS plugin that adds an import dialog to the creation screens of groups an courses.",
  "type": "project",
  "license": "GPL",
  "authors": [
    {
      "name": "Guido Vollbach",
      "email": "gvollbach@databay.de"
    }
  ],
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.11",
    "rector/rector": "^2.6",
    "captainhook/captainhook": "^5.29",
    "captainhook/hook-installer": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "ILIAS\\Plugin\\CrsGrpImport\\": "classes/"
    },
    "classmap": ["./classes"]
  },
  "require": {
    "php": "^8.2 || ^8.3"
  },
  "config": {
    "classmap-authoritative": true,
    "allow-plugins": {
      "captainhook/hook-installer": true
    }
  }
}
